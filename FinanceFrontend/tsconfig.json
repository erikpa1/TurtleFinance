{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": true,
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "noUnusedLocals": false,
        "noImplicitAny": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@Turtle/*": ["./src/Turtle/*"],
            "@TurtleFinance/*": ["./src/TurtleFinance/*"]
        }
    },
    "include": ["src", "TurtleThemeProvider.tsx"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
